{
  "kind": "collectionType",
  "collectionName": "analysis_submissions",
  "info": {
    "singularName": "analysis-submission",
    "pluralName": "analysis-submissions",
    "displayName": "Analizės užklausos",
    "description": "Projektų analizės formos pateikimai"
