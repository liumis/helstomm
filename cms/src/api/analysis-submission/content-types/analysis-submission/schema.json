      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "details": {
      "type": "text"
    },
    "notifyEmails": {
      "type": "text"
    },
    "attachment": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "files"]
    },
    "ipAddress": {
      "type": "string"
    },
    "userAgent": {
      "type": "text"
    },
    "deviceType": {
      "type": "enumeration",
      "enum": ["desktop", "mobile"]
    },
    "submittedAt": {
      "type": "datetime"
