{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Projects",
    "description": "Įgyvendinti projektai su kategorijų filtru"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "gyvenamieji",
        "industriniai",
        "komerciniai",
        "viesieji",
        "individualus",
        "inzineriniai"
      ],
      "required": true
    },
    "timeWeeks": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "location": {
      "type": "string",
      "required": true
    },
    "area": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
