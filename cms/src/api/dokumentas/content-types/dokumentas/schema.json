{
  "kind": "collectionType",
  "collectionName": "dokumentai",
  "info": {
    "singularName": "dokumentas",
    "pluralName": "dokumentai",
    "displayName": "Dokumentai",
    "description": "Projektavimo vadovai, mazgai, montavimo ir kokybės instrukcijos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["manual", "mazgas"],
      "required": true
    },
    "section": {
      "type": "enumeration",
      "enum": ["projektavimas", "montavimas", "kokybe"]
    },
    "subcategory": {
      "type": "string"
    },
    "acronym": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "version": {
      "type": "string"
    },
    "publishedOn": {
      "type": "string"
    },
    "pages": {
      "type": "integer"
    },
    "tags": {
      "type": "text"
    },
    "relatedCodes": {
      "type": "text"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "text"
    },
    "fileSize": {
      "type": "string"
    },
    "dwg": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "svg": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files", "images"]
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "pdfUrl": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
