# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate new values for production
APP_KEYS=tobemodified1,tobemodified2,tobemodified3,tobemodified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# First CMS login
CMS_ADMIN_EMAIL=admin@helstomm.lt
CMS_ADMIN_PASSWORD=HelstommAdmin123!

# Public site origins allowed to call the CMS (comma-separated, no trailing slash)
FRONTEND_URLS=https://test.helstomm.lt,https://helstomm.lt,https://www.helstomm.lt

# Form notification emails (HTML). Leave SMTP_HOST empty to save forms without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@helstomm.lt

# Notion CRM copy (Railway variable). Leave empty to skip Notion.
NOTION_TOKEN=
NOTION_DS_PEOPLE=1f60f567-99c8-4618-9fa9-29779e45120e
NOTION_DS_COMPANIES=85349973-b6a3-4399-a191-4356aacccc0e
NOTION_DS_USAGE=2a973ab5-4cfc-4845-b669-59961a93ccb9
NOTION_DS_CATALOG=ce23cf0c-0b4e-4153-bd5f-3464a7e6ae44
