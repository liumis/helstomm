# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate new values for production
APP_KEYS=tobemodified1,tobemodified2,tobemodified3,tobemodified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# First CMS login
CMS_ADMIN_EMAIL=admin@helstomm.lt
CMS_ADMIN_PASSWORD=HelstommAdmin123!

# Public site origins allowed to call the CMS (comma-separated, no trailing slash)
FRONTEND_URLS=https://test.helstomm.lt,https://helstomm.lt,https://www.helstomm.lt

# Form notification emails (HTML). Leave SMTP_HOST empty to save forms without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@helstomm.lt
